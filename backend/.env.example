NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3001
JSON_BODY_LIMIT=1mb

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=replace-with-database-user
DB_PASSWORD=replace-with-database-password
DB_NAME=replace-with-database-name
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=10000

JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
T8000_INGEST_TOKEN=replace-with-a-unique-ingest-token

T8000_MQTT_ENABLED=true
MQTT_PROTOCOL=mqtt
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=replace-with-broker-user
MQTT_PASSWORD=replace-with-broker-password
MQTT_SSL=false
MQTT_TOPIC=moe/+/Data
MQTT_QOS=0
MQTT_CLIENT_ID=tmas-backend-local
MQTT_CONNECT_TIMEOUT_MS=10000
MQTT_RECONNECT_PERIOD_MS=5000

LOG_RETENTION_DAYS=30
LOG_EXPORT_DIR=
